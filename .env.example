# ── Required ────────────────────────────────────────────────
ELEVENLABS_API_KEY=

# ── Model ───────────────────────────────────────────────────
# scribe_v3 (newest, recommended) | scribe_v2
MODEL_ID=scribe_v3

# ── Hotkey ──────────────────────────────────────────────────
# right_option | right_command | right_control | right_shift | fn
# left_option | left_command | left_control | left_shift
# f13 … f20
HOTKEY=right_option
# hold   = push-to-talk (hold key, speak, release)
# toggle = press once to start, press again to stop
MODE=hold

# ── Language ────────────────────────────────────────────────
# Empty = auto-detect (fine for switching between Greek and English).
# If you mostly speak Greek with English terms, try:
#   LANGUAGE_CODE=el
#   SECONDARY_LANGUAGE_CODES=en
LANGUAGE_CODE=
SECONDARY_LANGUAGE_CODES=
# digits ("42") or words ("forty-two") — Scribe v3 only
NUMBERS_FORMAT=digits

# ── Behaviour ───────────────────────────────────────────────
APPEND_SPACE=true          # adds a trailing space so dictations chain nicely
RESTORE_CLIPBOARD=true     # puts your previous clipboard back after pasting
SOUNDS=true                # Tink on start, Pop on stop, Basso on error
MIN_SECONDS=0.4            # ignore accidental taps shorter than this
MAX_SECONDS=300            # hard cap per dictation
# Mic: name substring (e.g. "MacBook", "Shure") or index. Empty = system default.
INPUT_DEVICE=
